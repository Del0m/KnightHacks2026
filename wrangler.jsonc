// Cloudflare Workers Builds: deploys the Expo web export as static assets (no Worker script).
// Workers Builds runs `npx wrangler deploy` from the repo root, which runs build.command first.
// EXPO_PUBLIC_* values are embedded at build time; set them in the Cloudflare build variables.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "knighthacks2026",
  "compatibility_date": "2026-09-01",
  "build": {
    "command": "cd apps/mobile && npm ci && npx expo export --platform web --output-dir dist"
  },
  "assets": {
    "directory": "apps/mobile/dist",
    // Static export has a page per route; anything else falls back to the client router.
    "not_found_handling": "single-page-application"
  }
}
