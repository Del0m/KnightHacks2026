# Public configuration only. Leave empty until your teammate supplies the URLs.
# Neon Console > Auth > Auth URL, including its /auth path.
EXPO_PUBLIC_NEON_AUTH_URL=
# Your app backend URL, not the Neon database connection string.
EXPO_PUBLIC_API_URL=
# true shows "Continue with Google". Turn it on only after Google is enabled in Neon Auth.
EXPO_PUBLIC_GOOGLE_SIGN_IN=
