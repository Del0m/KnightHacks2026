DATABRICKS_HOST=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
DATABRICKS_OAUTH_SCOPES="files model-serving sql"
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_VOLUME_PATH=/Volumes/spotter/raw/sessions
DATABRICKS_SERVING_ENDPOINT=form-quality
DATABRICKS_SCORE_TIMEOUT_MS=1200

# HMAC key for pseudonymous user ids sent to Databricks (CONN-02). Never rotate without a backfill.
SPOTTER_PSEUDONYM_SECRET=
