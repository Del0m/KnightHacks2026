# Copy to .env (never commit it). Values live in the team password manager (DB-01).

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Comma-separated browser origins for the Expo web build, e.g. http://localhost:8081
CORS_ORIGINS=

# ---- Neon (DB-01) ----
# Pooled connection string for YOUR branch: dev-<name> while developing.
# Neon console -> project spotter -> Branches -> dev-<name> -> Connect -> "Pooled connection".
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Only used by `npm run db:seed:demo`, which wipes and reseeds this branch. Point it at `demo`.
DEMO_DATABASE_URL=
# Optional: your Neon Auth user id, so the seed gives the presenter's account demo history.
DEMO_PRESENTER_USER_ID=

# ---- Neon Auth (BE-02) ----
# Neon console -> Auth -> Configuration. JWKS URL looks like https://<auth-host>/.well-known/jwks.json
NEON_AUTH_JWKS_URL=
# Optional extra checks on the token's iss / aud claims.
NEON_AUTH_ISSUER=
NEON_AUTH_AUDIENCE=

# ---- Databricks (CONN-01/02) ----
# Optional: without these the API runs and finished sessions stay export_status=pending.
DATABRICKS_HOST=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
DATABRICKS_OAUTH_SCOPES="files model-serving sql"
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_VOLUME_PATH=/Volumes/spotter/raw/sessions
DATABRICKS_SERVING_ENDPOINT=form-quality
DATABRICKS_SCORE_TIMEOUT_MS=1200

# HMAC key for pseudonymous user ids sent to Databricks (CONN-02). Never rotate without a backfill.
SPOTTER_PSEUDONYM_SECRET=

# Hugging Face Inference Providers (CONN-07). Fine-grained token with "Make calls to Inference Providers".
HF_TOKEN=
HF_WRITE_TOKEN=
# Optional: model:provider pairs tried in order
# HF_LLM_CHAIN=openai/gpt-oss-120b:cerebras,openai/gpt-oss-120b:together,openai/gpt-oss-20b:groq
# Optional: moderation model/provider (CONN-09). DeepInfra is the only live provider for Llama Guard 4.
# HF_GUARD_MODEL=meta-llama/Llama-Guard-4-12B
# HF_GUARD_PROVIDER=deepinfra
