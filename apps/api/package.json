{
  "name": "@spotter/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.check.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:replay": "vitest run test/replay",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:load-specs": "tsx --env-file-if-exists=.env scripts/load-specs.ts",
    "db:seed:demo": "tsx --env-file-if-exists=.env scripts/seed-demo.ts",
    "db:embed-profiles": "tsx --env-file-if-exists=.env scripts/embed-profiles.ts",
    "demo:prep": "tsx --env-file-if-exists=.env scripts/demo-prep.ts",
    "dev:token": "tsx --env-file-if-exists=.env scripts/dev-token.ts",
    "dev:smoke": "tsx --env-file-if-exists=.env scripts/dev-smoke.ts",
    "dev:signup": "tsx --env-file-if-exists=.env scripts/dev-token.ts --sign-up",
    "session:roundtrip": "tsx --env-file-if-exists=.env scripts/session-roundtrip.ts",
    "notes:samples": "tsx --env-file-if-exists=.env scripts/rest-note-samples.ts",
    "advice:samples": "tsx --env-file-if-exists=.env scripts/advice-samples.ts"
  },
  "dependencies": {
    "@databricks/sql": "^2.2.0",
    "@huggingface/inference": "^4.13.32",
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "jose": "^6.2.12",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "ws": "^8.22.0",
    "zod": "^3.25.76",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "basic-ftp": "^6.2.3"
  }
}
